---
import { Cancel01Icon, Menu01Icon, Search01Icon, User02Icon } from '@hugeicons/core-free-icons';
import { HugeiconsIcon } from '@hugeicons/react';
import { SHOP_SEARCH_MAX_LENGTH, type PublicShop } from '@omnivo/contracts';

import type { ShopLocale } from '../lib/locale';
import CartButton from './CartButton.astro';
import Logo from './Logo.astro';

// CLAUDE.md → Storefront → Header: one bar for both sizes. Desktop (Figma 37:3084): menu, logo,
// the search bar in the middle, cart and account. Phone (Figma 138:774): logo, then search, cart
// and account as white 40px buttons; the search button opens the search bar over the whole header.
interface Props {
  shop: PublicShop;
  locale: ShopLocale;
  // Step 26d.3: the search on screen (/search?q=neem), so the shopper can change a word instead
  // of typing it all again. null on every other page
  search: string | null;
}

const { shop, locale, search } = Astro.props;
const { t } = locale;
---

<header
  data-on-brand
  data-shop-header
  class="group relative mt-4 grid h-16 grid-cols-[1fr_auto] items-center rounded-2xl bg-brand p-3 md:mt-5 md:h-18 md:grid-cols-[auto_minmax(0,1fr)_auto] md:gap-x-6 md:px-6 md:py-0 lg:grid-cols-[1fr_auto_1fr]"
>
  {/* min-w-0: a long shop name gives way (the wordmark is cut with an ellipsis) instead of
      pushing the buttons on the right out of the bar */}
  <div class="flex min-w-0 items-center gap-2 md:gap-9">
    {/* Step 26d.4: opens the category drawer (CategoryDrawer.astro listens for
        data-open-categories). On the phone too, as a 40px white button like the ones on the
        right: Figma's phone header has no menu, but a header button reaches the drawer from every
        page (decision 31) */}
    <button
      type="button"
      data-open-categories
      aria-haspopup="dialog"
      aria-label={t('shop.header.categories')}
      class="grid size-10 shrink-0 place-items-center rounded-xl bg-card text-brand md:block md:size-auto md:rounded-none md:bg-transparent md:text-white"
    >
      <HugeiconsIcon
        icon={Menu01Icon}
        strokeWidth={1.5}
        className="size-5 md:size-[30px]"
        aria-hidden="true"
      />
    </button>
    <a href="/" aria-label={t('shop.header.home', { shop: shop.name })} class="min-w-0">
      <Logo shop={shop} place="header" />
    </a>
  </div>

  {/* On the phone the form is hidden until the search button opens it; then it covers the bar.
      z-10: the cart and account buttons come later in the markup, so without it they would paint
      over the search box and hide its submit button.
      From md to lg the bar has no room for Figma's centered 420px box beside the menu and the logo
      (at 768px the logo ran under it), so the middle column takes what is left, up to 420px. From
      lg the 1fr side columns center the box in the bar, as Figma draws it */}
  <form
    action="/search"
    method="get"
    role="search"
    class="absolute inset-0 z-10 hidden items-center gap-2 rounded-2xl bg-brand p-3 group-data-[search-open]:flex md:static md:z-auto md:flex md:w-full md:max-w-[420px] md:justify-self-center md:p-0 lg:w-[420px]"
  >
    <label class="relative block h-10 flex-1">
      <span class="sr-only">{t('shop.header.searchLabel')}</span>
      <input
        type="search"
        name="q"
        required
        maxlength={SHOP_SEARCH_MAX_LENGTH}
        value={search}
        placeholder={t('shop.header.searchPlaceholder')}
        class="h-full w-full rounded-full bg-card pr-14 pl-5 text-sf-body font-medium text-brand placeholder:text-muted focus-visible:outline-accent"
      />
      <button
        type="submit"
        aria-label={t('shop.header.search')}
        class="absolute top-0.5 right-0.5 grid h-9 w-[47px] place-items-center rounded-r-full bg-accent text-brand"
      >
        <HugeiconsIcon icon={Search01Icon} size={20} strokeWidth={1.5} aria-hidden="true" />
      </button>
    </label>
    <button
      type="button"
      data-search-close
      aria-label={t('shop.header.closeSearch')}
      class="grid size-10 place-items-center rounded-xl bg-card text-brand md:hidden"
    >
      <HugeiconsIcon icon={Cancel01Icon} size={20} strokeWidth={1.5} aria-hidden="true" />
    </button>
  </form>

  <div class="flex items-center justify-end gap-2">
    <button
      type="button"
      data-search-open
      aria-label={t('shop.header.openSearch')}
      class="grid size-10 place-items-center rounded-xl bg-card text-brand md:hidden"
    >
      <HugeiconsIcon icon={Search01Icon} size={20} strokeWidth={1.5} aria-hidden="true" />
    </button>
    <CartButton locale={locale} />
    {/* Step 26c: the order tracking page. The design's customer name needs a sign-in the shop does not have */}
    <a
      href="/track"
      class="grid size-10 place-items-center rounded-xl bg-card text-brand md:size-[42px] md:border md:border-on-brand-line md:bg-transparent md:text-white md:transition-colors md:duration-150 md:hover:bg-white/10 lg:flex lg:w-auto lg:gap-1 lg:py-2 lg:pr-2.5 lg:pl-2"
    >
      <HugeiconsIcon
        icon={User02Icon}
        strokeWidth={1.5}
        className="size-5 md:size-6"
        aria-hidden="true"
      />
      <span class="sr-only font-semibold lg:not-sr-only">{t('shop.header.account')}</span>
    </a>
  </div>
</header>

<script>
  // The phone's search button: open the search over the bar and put the cursor in it; the close
  // button or Escape puts the bar back and the focus on the search button
  for (const header of document.querySelectorAll<HTMLElement>('[data-shop-header]')) {
    const open = header.querySelector<HTMLButtonElement>('[data-search-open]');
    const close = header.querySelector<HTMLButtonElement>('[data-search-close]');
    const input = header.querySelector<HTMLInputElement>('input[type="search"]');
    if (!open || !close || !input) continue;

    const setOpen = (value: boolean): void => {
      header.toggleAttribute('data-search-open', value);
      if (value) input.focus();
      else open.focus();
    };
    open.addEventListener('click', () => {
      setOpen(true);
    });
    close.addEventListener('click', () => {
      setOpen(false);
    });
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-search-open')) setOpen(false);
    });
  }
</script>
