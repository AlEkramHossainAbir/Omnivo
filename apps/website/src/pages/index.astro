---
// The marketing landing page, "Halkhata" direction (docs/landing-prototypes/02-halkhata.html).
// The words are the prototype's. Placeholders that must be confirmed before launch: the 14-day
// trial, the plans' prices (src/data/plans.ts), the sales email, and the demo business names
// (Rahman Traders and the customers on the pages).
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/noto-sans-bengali/400.css';
import '@fontsource/noto-sans-bengali/500.css';
import '@fontsource/noto-sans-bengali/600.css';
// Only on the marketing site: the khata's handwriting (Atma) and its printed Bangla (Tiro
// Bangla). The app UI keeps Geist alone
import '@fontsource/atma/500.css';
import '@fontsource/atma/600.css';
import '@fontsource/tiro-bangla';
import '../styles/site.css';

import {
  Alert02Icon,
  ArrowRight01Icon,
  CashierIcon,
  DeliveryTruck01Icon,
  FactoryIcon,
  Globe02Icon,
  Medicine02Icon,
  Tick02Icon,
  TShirtIcon,
} from '@hugeicons/core-free-icons';
import { PUBLIC_APP_URL } from 'astro:env/client';

import Icon from '../components/Icon.astro';
import { PLANS, type Plan } from '../data/plans';

const app = PUBLIC_APP_URL.replace(/\/$/, '');
const title = 'Omnivo · The khata, rewritten';
const description =
  'The cloud ERP for Bangladeshi businesses: accounts, stock, dues, a POS counter and an online shop, in Bangla and English, and it keeps working offline.';

// Where a plan's button goes. The sign-up flow for a plan comes later; until then ?plan= tells
// the app which plan was picked (the app ignores it today). Enterprise is a conversation
// (PLACEHOLDER address)
const planHref = (plan: Plan): string =>
  plan.id === 'enterprise' ? 'mailto:sales@omnivo.app' : `${app}/sign-up?plan=${plan.id}`;

const pages = [
  {
    id: 'p1',
    n: '১',
    bn: 'জমা-খরচ',
    en: 'Accounts',
    title: 'The columns stay. The adding up goes.',
    body: 'Every invoice, money receipt, bill and POS shift posts its own double-entry journal. The trial balance balances by itself, grouped in lakh and crore, to the paisa.',
    old: 'যোগ মেলে না!',
    now: 'Balanced, ৳23,24,900.00',
  },
  {
    id: 'p2',
    n: '২',
    bn: 'মালের হিসাব',
    en: 'Inventory',
    title: 'Count once. Know every batch.',
    body: "Stock is kept in each product's base unit across every warehouse and depot. Packing suggests the batch that expires first, and low stock says how many strips are left.",
    old: 'মেয়াদ কবে? খাতায় নাই',
    now: 'AT-2408 · 4 days left',
  },
  {
    id: 'p3',
    n: '৩',
    bn: 'বাকির খাতা',
    en: 'Dues',
    title: 'Know who owes, and since when.',
    body: 'Credit limits stop an order before it ships. Aging sorts every customer into Current, 1–30, 31–60, 61–90 and Over 90 days, and advances stay in their own column.',
    old: 'কে কত দিন বাকি??',
    now: '৳80,000 over 90 days',
  },
  {
    id: 'p4',
    n: '৪',
    bn: 'ক্যাশ কাউন্টার',
    en: 'POS',
    title: 'The counter keeps selling, power or not.',
    body: 'Scan, take cash or bKash and print the receipt. The POS keeps selling offline and syncs when the line is back. Every shift ends with a blind cash count, and a difference posts to its own account.',
    old: 'ক্যাশে ৫২০ টাকা কম!',
    now: 'POS1-S0042 · ৳520 short, posted',
  },
  {
    id: 'p5',
    n: '৫',
    bn: 'কুরিয়ার',
    en: 'Online shop',
    title: "The rider's cash comes home, matched.",
    body: "Your shop turns orders into sales orders. Parcels book with Steadfast when packed, and the courier's payout is matched to the bank, charge by charge.",
    old: '৬০ টাকা কম কেন?',
    now: 'Charges ৳60 · Agrees',
  },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#F4F5F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A0D14" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <canvas id="stage" aria-hidden="true"></canvas>

    <header class="top">
      <div class="wrap">
        <a class="logo" href="#top" aria-label="Omnivo home">
          <span class="logo-mark"></span>Omnivo
        </a>
        <nav class="nav" aria-label="Main">
          {pages.map((p) => (
            <a href={`#${p.id}`}>{p.en}</a>
          ))}
          <a href="#pricing">Pricing</a>
        </nav>
        <div class="top-actions">
          {/* The app's sign-in page links on to sign-up ("Create workspace"), so one button
              covers both. Shown on phones too */}
          <a class="btn btn-secondary btn-sm" href={`${app}/login`}>
            Sign in
          </a>
          <a class="btn btn-primary btn-sm" href={`${app}/sign-up`}>
            Start free trial
          </a>
        </div>
      </div>
    </header>

    <div class="counter" aria-hidden="true">
      <span class="bar">
        <i id="bar"></i>
      </span>
      <span class="bn" id="folio">
        মলাট
      </span>
    </div>

    <main>
      <section class="hero" id="top" data-step>
        <div class="wrap">
          <div class="hero-copy">
            <span class="stamp">
              <span class="seal" lang="bn">
                হালখাতা
              </span>
              The ERP for Bangladeshi businesses
            </span>
            <h1>
              The <span class="strike">khata</span>
              <br />
              rewritten.
            </h1>
            <p class="bn-line" lang="bn">
              হালখাতার হিসাব, এবার ক্লাউডে — অফলাইনেও।
            </p>
            <p class="lede">
              Every shop, depot and factory here started with a red ledger book. Omnivo keeps its
              columns and takes away the adding up, the lost pages and the guessing. Scroll to turn
              the pages.
            </p>
            <div class="cta-row">
              <a class="btn btn-primary btn-lg" href="#start">
                Open your khata in Omnivo <Icon icon={ArrowRight01Icon} size={17} />
              </a>
              <a class="btn btn-secondary btn-lg" href="#p1">
                Turn the first page
              </a>
            </div>
            <ul class="trades" aria-label="Built for">
              <li>
                <Icon icon={TShirtIcon} size={16} />
                Garments
              </li>
              <li>
                <Icon icon={Medicine02Icon} size={16} />
                Pharmaceutical
              </li>
              <li>
                <Icon icon={DeliveryTruck01Icon} size={16} />
                Distribution
              </li>
              <li>
                <Icon icon={FactoryIcon} size={16} />
                Manufacturing
              </li>
            </ul>
          </div>
        </div>
      </section>

      {pages.map((p) => (
        <section class="page" id={p.id} data-step aria-labelledby={`${p.id}-title`}>
          <div class="wrap">
            <div class="cap">
              <div class="folio">
                <span class="n" lang="bn" aria-hidden="true">
                  {p.n}
                </span>
                <span class="w">
                  <b lang="bn">{p.bn}</b>
                  {p.en}
                </span>
              </div>
              <h2 id={`${p.id}-title`}>{p.title}</h2>
              <p class="body">{p.body}</p>
              <dl class="then-now">
                <div>
                  <dt>In the khata</dt>
                  <dd class="old" lang="bn">
                    {p.old}
                  </dd>
                </div>
                <div>
                  <dt>In Omnivo</dt>
                  <dd class="new">{p.now}</dd>
                </div>
              </dl>
            </div>
          </div>
        </section>
      ))}

      <section class="final" id="start" data-step aria-labelledby="start-title">
        <div class="wrap">
          <div class="final-card">
            <p class="bn-line" lang="bn">
              শুভ হালখাতা
            </p>
            <h2 id="start-title">Open this year's khata in Omnivo.</h2>
            <p class="body">
              The same book, on every counter and phone. It keeps selling through load-shedding and
              syncs when the line is back. The chart of accounts, VAT rates and the July to June
              year come set up.
            </p>
            <dl class="facts">
              <div>
                <dt>7 days</dt>
                <dd>of new work saved offline</dd>
              </div>
              <div>
                <dt>৳0.01</dt>
                <dd>kept exact, never rounded</dd>
              </div>
              <div>
                <dt class="bn" lang="bn">
                  বাংলা
                </dt>
                <dd>and English on every screen</dd>
              </div>
            </dl>
            <form class="ws-form" id="ws-form" action={`${app}/sign-up`} method="get" novalidate>
              <div class="ws-row">
                <label class="ws-input" for="ws-name">
                  <Icon icon={Globe02Icon} size={17} />
                  <input
                    id="ws-name"
                    name="workspace"
                    placeholder="rahman-traders"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                    aria-label="Workspace address"
                    aria-describedby="ws-hint"
                  />
                  <span class="suffix">.omnivo.app</span>
                </label>
                <button class="btn btn-primary btn-lg" type="submit">
                  Create workspace
                </button>
              </div>
              <p class="ws-error" id="ws-error" role="alert" hidden>
                <Icon icon={Alert02Icon} size={16} />
                <span></span>
              </p>
              <p class="hint" id="ws-hint">
                Free for 14 days. No card needed.
              </p>
            </form>
          </div>
        </div>
      </section>
      {/* Not a step of the book: its opaque background covers the fixed book as it scrolls up */}
      <section class="pricing" id="pricing" aria-labelledby="pricing-title">
        <div class="wrap">
          <div class="pricing-head">
            <div class="pricing-intro">
              <h2 id="pricing-title">Plans for every counter</h2>
              <p class="body">Start free. Move up when you add people, branches or depots.</p>
            </div>
            {/* Monthly / Yearly switches the prices with CSS alone (:has), so it works with no
                script. The radios are sr-only inside the fieldset, which is relative */}
            <fieldset class="seg">
              <legend class="sr-only">Billing</legend>
              <label>
                <input class="sr-only" type="radio" name="billing" value="monthly" checked />
                Monthly
              </label>
              <label>
                <input
                  class="sr-only"
                  type="radio"
                  name="billing"
                  value="yearly"
                  id="bill-yearly"
                />
                Yearly <span class="save">2 months free</span>
              </label>
            </fieldset>
          </div>
          <ul class="plans">
            {PLANS.map((plan) => (
              <li class="plan" data-recommended={plan.recommended ? '' : undefined}>
                <div class="plan-top">
                  <h3>{plan.name}</h3>
                  {plan.recommended && (
                    <span class="pill-brand">
                      <Icon icon={Tick02Icon} size={13} />
                      Recommended
                    </span>
                  )}
                </div>
                <p class="audience">{plan.audience}</p>
                {plan.price ? (
                  <>
                    <p class="price m">
                      <b>{plan.price.monthly}</b> / month
                    </p>
                    <p class="price y">
                      <b>{plan.price.yearlyPerMonth}</b> / month
                    </p>
                    <p class="billed m">Billed monthly</p>
                    <p class="billed y">Billed {plan.price.yearlyTotal} a year</p>
                  </>
                ) : (
                  <>
                    <p class="price">
                      <b>Custom</b>
                    </p>
                    <p class="billed">Priced for your users and branches</p>
                  </>
                )}
                <a
                  class:list={['btn', plan.recommended ? 'btn-primary' : 'btn-secondary']}
                  href={planHref(plan)}
                >
                  {plan.cta}
                </a>
                <ul class="features">
                  {plan.features.map((feature) => (
                    <li>
                      <Icon icon={Tick02Icon} size={16} />
                      {feature}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
          <p class="pricing-note">
            <Icon icon={CashierIcon} size={16} />
            Prices in taka. The online shop, courier booking and online payment are an add-on on any
            paid plan.
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <a class="logo" href="#top">
          <span class="logo-mark"></span>Omnivo
        </a>
        <nav aria-label="Footer">
          <a href="#p1">Product</a>
          <a href="#pricing">Pricing</a>
          <a href="#start">Contact</a>
        </nav>
        <span>© 2026 Omnivo</span>
      </div>
    </footer>

    <script>
      import { checkWorkspace } from '../scripts/workspace';

      // ---------- the workspace form ----------
      // It goes to the app's sign-up page with the address as ?workspace=. The check here only
      // saves a round trip; the API checks the address again and is the one that decides
      const form = document.getElementById('ws-form');
      const input = document.getElementById('ws-name');
      const error = document.getElementById('ws-error');
      if (form instanceof HTMLFormElement && input instanceof HTMLInputElement && error) {
        const box = input.closest('.ws-input');
        const show = (message: string | null): void => {
          error.hidden = message === null;
          const text = error.querySelector('span');
          if (text) text.textContent = message ?? '';
          if (message === null) {
            box?.removeAttribute('data-error');
            input.removeAttribute('aria-invalid');
            input.setAttribute('aria-describedby', 'ws-hint');
          } else {
            box?.setAttribute('data-error', '');
            input.setAttribute('aria-invalid', 'true');
            input.setAttribute('aria-describedby', 'ws-error ws-hint');
          }
        };
        form.addEventListener('submit', (event) => {
          const result = checkWorkspace(input.value);
          if (!result.ok) {
            event.preventDefault();
            show(result.message);
            input.focus();
            return;
          }
          input.value = result.slug;
        });
        // The error goes as soon as the address is fixed, not only on the next submit
        input.addEventListener('input', () => {
          if (!error.hidden && checkWorkspace(input.value).ok) show(null);
        });
      }

      // ---------- the page counter ----------
      // The pricing section covers the book, so the book's folio would only sit on top of the
      // pricing cards and the footer. It steps aside while pricing or the footer is on screen
      const counter = document.querySelector<HTMLElement>('.counter');
      const after = [document.getElementById('pricing'), document.querySelector('footer')];
      if (counter) {
        const showing = new Set<Element>();
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) showing.add(entry.target);
            else showing.delete(entry.target);
          }
          counter.hidden = showing.size > 0;
        });
        for (const el of after) if (el) observer.observe(el);
      }

      // ---------- the book ----------
      // three.js loads only when the book can be shown: never with Save-Data (a phone on a
      // metered connection), and the page works without it. Any failure (no WebGL, a blocked
      // GPU, a chunk that did not load) leaves the page as plain text and cards
      const canvas = document.getElementById('stage');
      const connection: unknown = Reflect.get(navigator, 'connection');
      const saveData =
        typeof connection === 'object' &&
        connection !== null &&
        Reflect.get(connection, 'saveData') === true;
      const noStage = (): void => document.documentElement.classList.add('no-stage');
      if (!(canvas instanceof HTMLCanvasElement) || saveData) {
        noStage();
      } else {
        import('../scripts/book/stage')
          .then(({ startStage }) =>
            startStage({
              canvas,
              steps: [...document.querySelectorAll<HTMLElement>('[data-step]')],
              folio: document.getElementById('folio'),
              bar: document.getElementById('bar'),
            }),
          )
          .catch(noStage);
      }
    </script>
  </body>
</html>
