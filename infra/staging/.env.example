# One stack's settings. The server runs two stacks from the same files, each in its own folder
# with its own .env: production in /srv/omnivo, demo in /srv/omnivo-demo. Copy this file into the
# folder as .env, fill it in, and `chmod 600 .env`. Never commit the filled-in file.
#
# Every secret is different in each stack: the demo never shares a password with production.
#
# Make each secret with:  openssl rand -hex 32
# Hex (0-9, a-f) has no character that needs escaping inside a URL or this file.

# --- Which stack this is. deploy.sh refuses a build made for the other one. ---
# demo or production
DEPLOY_TARGET=demo
# The Compose project: it names the containers, the network and the volumes (the database's data
# lives in <project>_db-data). omnivo-production or omnivo-demo. Never change it on a running
# stack: a new name starts an empty database next to the old one.
COMPOSE_PROJECT_NAME=omnivo-demo

# --- Host names, without https://. compose.yml builds the https:// addresses from them. Each one
# is a public host name of the Cloudflare Tunnel, and all of them lead to Caddy. ---
# Production: app, api, files, mail, shop.<domain>. Demo: demo, demo-api, demo-files, demo-mail,
# demo-shop.<domain> (one level below the domain, because Cloudflare's free certificate covers
# only *.<domain>).
APP_HOST=demo.example.com
API_HOST=demo-api.example.com
FILES_HOST=demo-files.example.com
MAIL_HOST=demo-mail.example.com
SHOP_HOST=demo-shop.example.com

# Emails come "from" <MAIL_FROM_NAME> <no-reply@MAIL_FROM_DOMAIN>. Mailpit catches them all, so
# nothing is sent out. Production: Omnivo. Demo: Omnivo Demo, so a tester sees which one wrote.
# Quoted: deploy.sh reads this file with bash too, and a space without quotes breaks it
MAIL_FROM_NAME="Omnivo Demo"
MAIL_FROM_DOMAIN=example.com

# The job queue's memory cap. Production 256mb; the demo 128mb, so the two fit on a small server.
VALKEY_MAXMEMORY=128mb

# --- Cloudflare Tunnel. Each stack has its own tunnel (omnivo for production, omnivo-demo for the
# demo). The token lets cloudflared run that one tunnel, nothing else. Get it on the server with:
#   cloudflared tunnel token <tunnel name> ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Images ---
REGISTRY=ghcr.io/your-github-user-or-org
# The git commit that is running. deploy.sh writes this line; leave it empty.
IMAGE_TAG=

# --- Database. Each role has its own password. ---
POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=

# --- Auth. At least 32 characters each. Changing one signs everyone out. ---
BETTER_AUTH_SECRET=
JWT_SECRET=

# --- File storage (MinIO). The root key only sets things up; the API uses its own key. ---
MINIO_ROOT_PASSWORD=
S3_APP_SECRET=

# --- Mailpit's sign-in. Share it with the testers. ---
MAIL_UI_USER=tester
MAIL_UI_PASSWORD=
