    "test": "vitest run"
  },
  "dependencies": {
    "@omnivo/contracts": "workspace:*",
    "dexie": "^4.4.6",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@omnivo/config": "workspace:*",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
