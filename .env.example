# App runtime — NOBYPASSRLS role, সব tenant query এই দিয়ে যাবে
DATABASE_URL=postgres://omnivo_app:app_dev_password@localhost:5432/omnivo

# Migration/seed শুধু — DDL চালায়; FORCE RLS-এর কারণে ডেটা লিখতে tenant context লাগে
MIGRATOR_DATABASE_URL=postgres://omnivo_migrator:migrator_dev_password@localhost:5432/omnivo

# Worker only: the outbox relay's role (omnivo_worker). It reads the outbox of every tenant and
# nothing else; the worker's jobs use DATABASE_URL like the API does
WORKER_DATABASE_URL=postgres://omnivo_worker:worker_dev_password@localhost:5432/omnivo

# Valkey (Redis-compatible) — permission cache (API) and BullMQ queues (worker)
REDIS_URL=redis://localhost:6379

# JWT-এর `iss` আর Better Auth-এর baseURL — API নিজের ঠিকানা
API_BASE_URL=http://localhost:3000
# CORS: শুধু এই origin থেকে cookie সহ request চলবে
APP_ORIGIN=http://localhost:5173

# শুধু dev-এর জন্য। production-এ প্রতিটা আলাদা করে বানান: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# ফাইল storage (S3-এর মতো API) — dev-এ docker-compose-এর MinIO, production-এ Cloudflare R2।
# bucket না থাকলে dev-এ API নিজেই বানায়
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=omnivo
S3_ACCESS_KEY_ID=omnivo
S3_SECRET_ACCESS_KEY=omnivo-dev-secret

# Step 26f: the online shop's public API. A shop's address is its subdomain + this domain
# (nirvor.localhost:4331 in dev). The shop's photos are read from STOREFRONT_MEDIA_URL/storefront/;
# left out, it is S3_ENDPOINT/S3_BUCKET (right for MinIO). Production needs an https address
SHOP_BASE_DOMAIN=localhost
# STOREFRONT_MEDIA_URL=https://media.omnivo.shop
# Step 26g: the port in a shop's address for the Storefront screens' "View shop" link. Left out:
# 4321 (the shop's dev server) outside production, none in production
# SHOP_PUBLIC_PORT=4321
# Step 27a: the key the shop's server sends on the order routes (X-Shop-Key). The shop's own
# SHOP_API_KEY must have the same value. Left out, the API takes no orders (every order route
# answers 401). At least 32 characters; make a real one with: openssl rand -base64 32
STOREFRONT_SHOP_KEY=dev-only-shop-key-change-me-0123456789abcdef
# Step 27d: online payment, read by the API and the worker. PAYMENT_GATEWAY is fake (the shop's own
# fake page, pays nothing) or sslcommerz; left out, fake outside production and sslcommerz in
# production, which refuses fake. CREDENTIALS_KEY seals each shop's gateway password: 32 random
# bytes in base64 (openssl rand -base64 32), its own secret. Left out, the Payment card cannot
# save a password. Changing it later makes every saved password unreadable until it is typed again
# PAYMENT_GATEWAY=fake
CREDENTIALS_KEY=ZGV2LW9ubHktY3JlZGVudGlhbHMta2V5LTMyYnl0ZXM=
# Step 28a: couriers, read by the API and the worker. COURIER_MODE is fake (books every parcel
# without calling anyone; move a parcel by posting a webhook) or live (Steadfast's own API); left
# out, fake outside production and live in production, which refuses fake. A courier account's
# keys are sealed with CREDENTIALS_KEY above
# COURIER_MODE=fake
# Step 26f.5: the shop's server (apps/shop) reads these, not the API. Left out, it shows the mock
# shop. To see a launched shop from the API: SHOP_SOURCE=api SHOP_API_URL=http://localhost:3000
# SHOP_API_KEY=<STOREFRONT_SHOP_KEY above> pnpm --filter @omnivo/shop dev, then open
# http://<subdomain>.localhost:4321. Step 27a: SHOP_API_KEY is required with SHOP_SOURCE=api
# SHOP_SOURCE=api
# SHOP_API_URL=http://localhost:3000
# SHOP_API_KEY=dev-only-shop-key-change-me-0123456789abcdef

# Email — only the worker sends it (invitations, welcome). Dev: docker-compose's Mailpit; every
# email lands at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Omnivo <no-reply@omnivo.app>
